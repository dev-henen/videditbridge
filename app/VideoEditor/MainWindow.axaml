<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:VideoEditor.Controls"
        xmlns:local="using:VideoEditor"
        x:Class="VideoEditor.MainWindow"
        Title="{Binding Title}" Width="960" Height="460" MinWidth="760" MinHeight="400"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        Icon="/Assets/AppIcon.png">
  <Window.Styles>
    <!-- Status dot: grey when idle, a pulsing blue while anything runs -->
    <Style Selector="Ellipse.status">
      <Setter Property="Fill" Value="{StaticResource Faint}"/>
    </Style>
    <Style Selector="Ellipse.status.busy">
      <Setter Property="Fill" Value="{StaticResource Accent}"/>
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Activity labels: muted when finished, bright while running, underlined on error -->
    <Style Selector="TextBlock.activity">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style Selector="TextBlock.activity.running">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="TextBlock.activity.error">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="TextDecorations" Value="Underline"/>
    </Style>
    <Style Selector="TextBlock.finding">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style Selector="TextBlock.finding.problem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <!-- The Ask box: no border until it has focus, then a blue one -->
    <Style Selector="Border.ask">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.ask:focus-within">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>
    <!-- The activity glow fades in and out -->
    <Style Selector="Border#Glow">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.35"/>
        </Transitions>
      </Setter>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <!-- Top bar -->
    <DockPanel Grid.Row="0" Margin="10,6,8,4" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Classes="icon" Text="{x:Static local:Icons.Video}" FontSize="17" Foreground="{StaticResource Text}" Margin="0,0,8,0"/>
        <TextBlock Text="{Binding ProjectName, TargetNullValue=AI Video Editor}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="240"/>
        <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,1,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Click="OnShowProjects" ToolTip.Tip="Projects" AutomationProperties.Name="Projects">
          <TextBlock Classes="icon" Text="{x:Static local:Icons.Folder}"/>
        </Button>
        <Button Click="OnImport" IsEnabled="{Binding IsProjectOpen}" ToolTip.Tip="Import media" AutomationProperties.Name="Import media">
          <TextBlock Classes="icon" Text="{x:Static local:Icons.Add}"/>
        </Button>
        <Rectangle Width="1" Height="16" Fill="{StaticResource Line}" Margin="5,0"/>
        <Button Click="OnUndo" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo" AutomationProperties.Name="Undo">
          <TextBlock Classes="icon" Text="{x:Static local:Icons.Undo}"/>
        </Button>
        <Button Click="OnRedo" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo" AutomationProperties.Name="Redo">
          <TextBlock Classes="icon" Text="{x:Static local:Icons.Redo}"/>
        </Button>
        <Rectangle Width="1" Height="16" Fill="{StaticResource Line}" Margin="5,0"/>
        <Button Click="OnOverview" IsEnabled="{Binding IsProjectOpen}" ToolTip.Tip="Overview of the whole video" AutomationProperties.Name="Overview of the whole video">
          <TextBlock Classes="icon" Text="{x:Static local:Icons.Grid}"/>
        </Button>
        <Button Click="OnPreview" IsEnabled="{Binding IsProjectOpen}" ToolTip.Tip="Render a preview video" AutomationProperties.Name="Render a preview video">
          <TextBlock Classes="icon" Text="{x:Static local:Icons.Video}"/>
        </Button>
        <Button Classes="primary" Click="OnExport" IsEnabled="{Binding IsProjectOpen}" ToolTip.Tip="Export the final video" AutomationProperties.Name="Export the final video" Margin="6,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="icon" Text="{x:Static local:Icons.Export}" FontSize="15" Foreground="{StaticResource OnAccent}" Margin="0,0,6,0"/>
            <TextBlock Text="Export" Foreground="{StaticResource OnAccent}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="8,0,8,0" ColumnDefinitions="*,8,0.5*">
      <!-- Viewer -->
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8">
        <Grid Margin="6" RowDefinitions="Auto,*,Auto">
          <DockPanel Grid.Row="0" Margin="2,0,0,5">
            <Border x:Name="LiveBadge" DockPanel.Dock="Left" Background="#26FFFFFF" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource Text}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="LiveText" Text="LIVE" FontSize="10" FontWeight="Bold"/>
              </StackPanel>
            </Border>
            <Button x:Name="FollowButton" DockPanel.Dock="Right" Click="OnFollowLive" ToolTip.Tip="Follow live output" AutomationProperties.Name="Follow live output"
                    IsVisible="False" MinHeight="22" Padding="6,2">
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="icon" Text="{x:Static local:Icons.Sync}" FontSize="13" Margin="0,0,5,0"/>
                <TextBlock Text="Follow live" FontSize="11" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="ViewerCaption" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11"
                       Text="Following the latest output" TextTrimming="CharacterEllipsis"/>
          </DockPanel>

          <Border Grid.Row="1" Background="Black" CornerRadius="6" ClipToBounds="True">
            <!-- Click the picture to point Claude at a spot in the frame -->
            <Grid x:Name="ViewerArea" Background="Transparent" PointerReleased="OnViewerClick" SizeChanged="OnViewerResized" Cursor="Cross">
              <!-- Frames, the overview and video playback all show here (video frames come from the player) -->
              <Image x:Name="FrameImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"/>
              <TextBlock x:Name="ViewerEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Faint}"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="20" Text="Nothing to show yet"/>
              <Canvas IsHitTestVisible="False">
                <Grid x:Name="SpotMarker" Width="18" Height="18" IsVisible="False">
                  <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2" Fill="{StaticResource AccentSoft}"/>
                  <Ellipse Width="4" Height="4" Fill="{StaticResource Accent}"/>
                </Grid>
              </Canvas>
            </Grid>
          </Border>

          <DockPanel Grid.Row="2" Margin="0,5,2,0" IsEnabled="{Binding IsProjectOpen}">
            <Button x:Name="PlayButton" DockPanel.Dock="Left" Click="OnPlayPause" ToolTip.Tip="Play / pause" AutomationProperties.Name="Play / pause" MinHeight="24">
              <TextBlock x:Name="PlayIcon" Classes="icon" Text="{x:Static local:Icons.Play}" FontSize="14" Foreground="{StaticResource Text}"/>
            </Button>
            <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Width="96" TextAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" FontSize="11" Text="00:00.0 / 00:00.0"/>
            <Slider x:Name="Scrubber" Minimum="0" Maximum="{Binding Duration}" VerticalAlignment="Center" Margin="4,0" MinHeight="0" Padding="0"
                    IsSnapToTickEnabled="False"/>
          </DockPanel>
        </Grid>
      </Border>

      <!-- Session panel -->
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" MinWidth="240" MaxWidth="400">
        <DockPanel>
          <!-- Now -->
          <StackPanel DockPanel.Dock="Top" Margin="10,9,10,6">
            <DockPanel>
              <Ellipse DockPanel.Dock="Left" Classes="status" Classes.busy="{Binding IsBusy}" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}"/>
            </DockPanel>
            <ProgressBar Margin="0,7,0,0" Value="{Binding StatusPercent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding StatusIndeterminate, Mode=OneWay}"
                         IsVisible="{Binding IsBusy}"/>
          </StackPanel>
          <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource Line}"/>

          <TabControl x:Name="SideTabs" Margin="4" Padding="0">
            <TabItem Header="Activity">
              <ListBox ItemsSource="{Binding Activities}" Margin="0,4,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="6,4" ColumnDefinitions="20,*,Auto">
                      <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,1,0,0">
                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Check}" FontSize="13" Foreground="{StaticResource Muted}" IsVisible="{Binding IsDone}"/>
                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Error}" FontSize="13" Foreground="{StaticResource Text}" IsVisible="{Binding IsError}"/>
                        <TextBlock Classes="icon spin" Text="{x:Static local:Icons.Sync}" FontSize="13" Foreground="{StaticResource Accent}" IsVisible="{Binding IsRunning}"/>
                      </Grid>
                      <StackPanel Grid.Column="1">
                        <TextBlock Classes="activity" Classes.running="{Binding IsRunning}" Classes.error="{Binding IsError}" Text="{Binding Label}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Faint}" Margin="0,1,0,0"
                                   IsVisible="{Binding HasDetail}" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Margin="0,4,0,1" Height="2" MinHeight="2" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                     IsVisible="{Binding ShowProgress}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="10" Foreground="{StaticResource Faint}" Margin="6,2,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem x:Name="ClaudeTab" Header="Claude">
              <DockPanel>
                <!-- Options Claude offered: play or look, then pick -->
                <Border DockPanel.Dock="Top" Margin="4,6,4,2" Padding="8,6" CornerRadius="8" Background="{StaticResource Panel2}" IsVisible="{Binding HasChoices}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                      <Button DockPanel.Dock="Right" Click="OnDismissChoices" ToolTip.Tip="Close without picking" AutomationProperties.Name="Close the options"
                              MinHeight="20" MinWidth="20" Padding="2">
                        <TextBlock Classes="icon" Text="{x:Static local:Icons.Dismiss}" FontSize="11"/>
                      </Button>
                      <TextBlock Text="{Binding ChoiceQuestion}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Choices}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Margin="0,3" Padding="6" CornerRadius="6" Background="{StaticResource Panel}">
                              <DockPanel>
                                <Button DockPanel.Dock="Right" Classes="primary" Click="OnPickChoice" Tag="{Binding}" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0"
                                        Margin="6,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Pick this" AutomationProperties.Name="Pick this"
                                        IsEnabled="{Binding $parent[Window].DataContext.CanAsk}">
                                  <TextBlock Classes="icon" Text="{x:Static local:Icons.Check}" FontSize="13" Foreground="{StaticResource OnAccent}"/>
                                </Button>
                                <Button DockPanel.Dock="Left" Click="OnPlayChoice" Tag="{Binding}" MinHeight="22" MinWidth="22" Padding="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding PlayHint}" AutomationProperties.Name="Play this option" IsVisible="{Binding HasAudio}">
                                  <TextBlock Classes="icon" Text="{Binding PlayGlyph}" FontSize="13" Foreground="{StaticResource Accent}"/>
                                </Button>
                                <Border DockPanel.Dock="Left" CornerRadius="4" ClipToBounds="True" Margin="0,0,8,0" IsVisible="{Binding HasImage}">
                                  <Image Source="{Binding ImageBitmap}" Height="54" MaxWidth="96" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                  <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
                                </StackPanel>
                              </DockPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Border>
                <ScrollViewer x:Name="AgentScroll" VerticalScrollBarVisibility="Auto" Padding="8">
                  <SelectableTextBlock Text="{Binding AgentText}" TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource Text}" FontSize="12"/>
                </ScrollViewer>
              </DockPanel>
            </TabItem>
            <TabItem x:Name="ReviewTab" Header="Review">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="6,6,2,4">
                  <Button DockPanel.Dock="Right" Click="OnReview" IsEnabled="{Binding IsProjectOpen}" ToolTip.Tip="Check the edit for problems" AutomationProperties.Name="Check the edit for problems">
                    <TextBlock Classes="icon" Text="{x:Static local:Icons.Review}"/>
                  </Button>
                  <TextBlock Text="{Binding ReviewSummary}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <ListBox x:Name="FindingList" ItemsSource="{Binding Findings}" SelectionChanged="OnFindingSelected">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="6,4">
                        <Button DockPanel.Dock="Right" Click="OnFix" Tag="{Binding}" VerticalAlignment="Top" Margin="6,0,0,0" MinHeight="22" MinWidth="22" Padding="3"
                                IsEnabled="{Binding $parent[Window].DataContext.CanAsk}"
                                ToolTip.Tip="Ask Claude to fix this" AutomationProperties.Name="Ask Claude to fix this">
                          <TextBlock Classes="icon" Text="{x:Static local:Icons.Wrench}" FontSize="13" Foreground="{StaticResource Accent}"/>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Classes="icon finding" Classes.problem="{Binding IsProblem}" Text="{Binding Glyph}" FontSize="13" Width="18"
                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel>
                          <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="{StaticResource Faint}"/>
                          <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>
            <TabItem Header="Summary">
              <TextBox Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="10.5"
                       Classes="bare" TextWrapping="Wrap" Padding="6" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </TabItem>
            <TabItem Header="History">
              <ListBox ItemsSource="{Binding History}" Margin="0,4,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="6,3">
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="64" Foreground="{StaticResource Faint}" FontSize="10"/>
                      <TextBlock Text="{Binding Action}" FontSize="11" Foreground="{StaticResource Muted}"/>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>

      <!-- Projects screen (covers the workspace) -->
      <Border Grid.ColumnSpan="3" Background="{StaticResource Bg}" IsVisible="{Binding ShowStartScreen}">
        <Grid MaxWidth="620" VerticalAlignment="Center" Margin="16,0">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Click="OnHideProjects" ToolTip.Tip="Back to the open project" AutomationProperties.Name="Back to the open project"
                      IsVisible="{Binding IsProjectOpen}">
                <TextBlock Classes="icon" Text="{x:Static local:Icons.Dismiss}"/>
              </Button>
              <TextBlock Text="Projects" FontSize="18" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock Text="{Binding EngineError}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding HasEngineError}"/>
            <DockPanel Margin="0,8,0,10">
              <Button DockPanel.Dock="Right" Classes="primary" Click="OnCreateProject" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="icon" Text="{x:Static local:Icons.Add}" FontSize="14" Foreground="{StaticResource OnAccent}" Margin="0,0,6,0"/>
                  <TextBlock Text="New" Foreground="{StaticResource OnAccent}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <ComboBox DockPanel.Dock="Right" Width="80" Margin="6,0,0,0" ItemsSource="{Binding AspectRatios}" SelectedItem="{Binding NewProjectAspect}"/>
              <TextBox Text="{Binding NewProjectName}"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,4">
              <Button DockPanel.Dock="Right" Click="OnOpenFolder" ToolTip.Tip="Open a project folder" AutomationProperties.Name="Open a project folder">
                <TextBlock Classes="icon" Text="{x:Static local:Icons.FolderOpen}"/>
              </Button>
              <TextBlock Text="Recent" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox x:Name="ProjectList" ItemsSource="{Binding Projects}" MaxHeight="220" DoubleTapped="OnProjectDoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="6,6">
                    <Button DockPanel.Dock="Right" Click="OnOpenProject" Tag="{Binding Dir}" ToolTip.Tip="Open" AutomationProperties.Name="Open">
                      <TextBlock Classes="icon" Text="{x:Static local:Icons.Open}" FontSize="14"/>
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Classes="icon" Text="{x:Static local:Icons.Folder}" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"/>
                      <TextBlock Text="{Binding Updated}" FontSize="10" Foreground="{StaticResource Faint}"/>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Timeline strip: compact preview; expand for full lanes -->
    <Border Grid.Row="2" Margin="8,6,8,0" Background="{StaticResource Panel}" CornerRadius="8" Padding="4,3">
      <DockPanel>
        <Button x:Name="ExpandTimeline" DockPanel.Dock="Right" Click="OnToggleTimeline" ToolTip.Tip="Show all timeline lanes" AutomationProperties.Name="Show all timeline lanes"
                VerticalAlignment="Top" MinHeight="22" MinWidth="24" Padding="4,2">
          <TextBlock x:Name="ExpandIcon" Classes="icon" Text="{x:Static local:Icons.ChevronUp}" FontSize="12"/>
        </Button>
        <ScrollViewer x:Name="TimelineScroll" VerticalScrollBarVisibility="Auto" MaxHeight="160">
          <controls:TimelineView x:Name="Timeline"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Ask Claude: one box holding the picked item, the request and the send (or stop) button -->
    <Grid Grid.Row="3" Margin="8,6,8,8">
      <Border Classes="ask" CornerRadius="10" BorderThickness="1" Padding="10,6,6,6">
        <StackPanel>
          <!-- What the request is about: pills above the text for the item picked on the timeline and the spot clicked in the frame -->
          <StackPanel x:Name="Pills" Orientation="Horizontal" Margin="0,0,0,4" IsVisible="False">
            <Border x:Name="PickChip" IsVisible="False" Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="8,1,2,1" Margin="0,0,6,0" MaxWidth="300">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PickText" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                <Button Click="OnClearPick" ToolTip.Tip="Clear" AutomationProperties.Name="Clear the picked item" MinHeight="18" MinWidth="18" Padding="0" Margin="4,0,0,0">
                  <TextBlock Classes="icon" Text="{x:Static local:Icons.Dismiss}" FontSize="10"/>
                </Button>
              </StackPanel>
            </Border>
            <Border x:Name="SpotChip" IsVisible="False" Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="8,1,2,1">
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="icon" Text="{x:Static local:Icons.Location}" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,5,0"/>
                <TextBlock x:Name="SpotText" FontSize="11" VerticalAlignment="Center"/>
                <Button Click="OnClearSpot" ToolTip.Tip="Clear" AutomationProperties.Name="Clear the spot" MinHeight="18" MinWidth="18" Padding="0" Margin="4,0,0,0">
                  <TextBlock Classes="icon" Text="{x:Static local:Icons.Dismiss}" FontSize="10"/>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="primary" Click="OnStopClaude" ToolTip.Tip="Stop Claude" AutomationProperties.Name="Stop Claude"
                    Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" Margin="6,0,0,2" VerticalAlignment="Bottom"
                    IsVisible="{Binding AgentRunning}">
              <TextBlock Classes="icon" Text="{x:Static local:Icons.Stop}" FontSize="12" Foreground="{StaticResource OnAccent}"/>
            </Button>
            <Button DockPanel.Dock="Right" Classes="primary" Click="OnAsk" IsEnabled="{Binding CanAsk}" ToolTip.Tip="Ask Claude" AutomationProperties.Name="Ask Claude"
                    Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" Margin="6,0,0,2" VerticalAlignment="Bottom"
                    IsVisible="{Binding !AgentRunning}">
              <TextBlock Classes="icon" Text="{x:Static local:Icons.Send}" FontSize="13" Foreground="{StaticResource OnAccent}"/>
            </Button>
            <TextBox x:Name="PromptBox" Classes="bare" KeyDown="OnPromptKeyDown" IsEnabled="{Binding CanAsk}" Padding="0,4" MinHeight="26"
                     Watermark="{Binding AskHint}" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Activity glow: while anything runs, a light travels around the box and it softly glows -->
      <Border x:Name="Glow" CornerRadius="10" BorderThickness="1.5" IsHitTestVisible="False" Opacity="0"
              BoxShadow="0 0 14 0 #803B82F6">
        <Border.BorderBrush>
          <ConicGradientBrush Center="50%,50%">
            <GradientStop Color="#1D4ED8" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="0.35"/>
            <GradientStop Color="#BFDBFE" Offset="0.5"/>
            <GradientStop Color="#3B82F6" Offset="0.65"/>
            <GradientStop Color="#1D4ED8" Offset="1"/>
          </ConicGradientBrush>
        </Border.BorderBrush>
      </Border>
    </Grid>
  </Grid>
</Window>
