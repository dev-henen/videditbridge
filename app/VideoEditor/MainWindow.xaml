<Window x:Class="VideoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoEditor.Controls"
        Title="{Binding Title}" Width="960" Height="460" MinWidth="760" MinHeight="400"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        TextOptions.TextRenderingMode="Grayscale" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <DockPanel Grid.Row="0" Margin="10,6,8,4" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="15" Foreground="{StaticResource Text}" Margin="0,0,8,0"/>
        <TextBlock Text="{Binding ProjectName, TargetNullValue=AI Video Editor}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="240"/>
        <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,1,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Click="OnShowProjects" ToolTip="Projects" AutomationProperties.Name="Projects">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;"/>
        </Button>
        <Button Click="OnImport" IsEnabled="{Binding IsProjectOpen}" ToolTip="Import media" AutomationProperties.Name="Import media">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE710;"/>
        </Button>
        <Rectangle Width="1" Height="16" Fill="{StaticResource Line}" Margin="5,0"/>
        <Button Click="OnUndo" IsEnabled="{Binding CanUndo}" ToolTip="Undo" AutomationProperties.Name="Undo">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;"/>
        </Button>
        <Button Click="OnRedo" IsEnabled="{Binding CanRedo}" ToolTip="Redo" AutomationProperties.Name="Redo">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;"/>
        </Button>
        <Rectangle Width="1" Height="16" Fill="{StaticResource Line}" Margin="5,0"/>
        <Button Click="OnOverview" IsEnabled="{Binding IsProjectOpen}" ToolTip="Overview of the whole video" AutomationProperties.Name="Overview of the whole video">
          <TextBlock Style="{StaticResource Icon}" Text="&#xF0E2;"/>
        </Button>
        <Button Click="OnPreview" IsEnabled="{Binding IsProjectOpen}" ToolTip="Render a preview video" AutomationProperties.Name="Render a preview video">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE714;"/>
        </Button>
        <Button Style="{StaticResource Primary}" Click="OnExport" IsEnabled="{Binding IsProjectOpen}" ToolTip="Export the final video" AutomationProperties.Name="Export the final video" Margin="6,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="13" Margin="0,0,6,0"/>
            <TextBlock Text="Export" Foreground="{StaticResource OnAccent}" FontWeight="SemiBold"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="8,0,8,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="0.5*" MinWidth="240" MaxWidth="400"/>
      </Grid.ColumnDefinitions>

      <!-- Viewer -->
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8">
        <Grid Margin="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="2,0,0,5">
            <Border x:Name="LiveBadge" DockPanel.Dock="Left" Background="#26FFFFFF" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource Text}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="LiveText" Text="LIVE" FontSize="10" FontWeight="Bold"/>
              </StackPanel>
            </Border>
            <Button x:Name="FollowButton" DockPanel.Dock="Right" Click="OnFollowLive" ToolTip="Follow live output" AutomationProperties.Name="Follow live output" Visibility="Collapsed" MinHeight="22" Padding="6,2">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="11" Margin="0,0,5,0"/>
                <TextBlock Text="Follow live" FontSize="11"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="ViewerCaption" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11"
                       Text="Following the latest output" TextTrimming="CharacterEllipsis"/>
          </DockPanel>

          <Border Grid.Row="1" Background="Black" CornerRadius="6" ClipToBounds="True">
            <!-- Click the picture to point Claude at a spot in the frame -->
            <Grid x:Name="ViewerArea" Background="Transparent" MouseLeftButtonUp="OnViewerClick" SizeChanged="OnViewerResized" Cursor="Cross">
              <Image x:Name="FrameImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
              <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed"
                            MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded"/>
              <TextBlock x:Name="ViewerEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Faint}"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="20" Text="Nothing to show yet"/>
              <Canvas IsHitTestVisible="False">
                <Grid x:Name="SpotMarker" Width="18" Height="18" Visibility="Collapsed">
                  <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2" Fill="{StaticResource AccentSoft}"/>
                  <Ellipse Width="4" Height="4" Fill="{StaticResource Accent}"/>
                </Grid>
              </Canvas>
            </Grid>
          </Border>

          <DockPanel Grid.Row="2" Margin="0,5,2,0" IsEnabled="{Binding IsProjectOpen}">
            <Button x:Name="PlayButton" DockPanel.Dock="Left" Click="OnPlayPause" ToolTip="Play / pause" AutomationProperties.Name="Play / pause" MinHeight="24">
              <TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Foreground="{StaticResource Text}"/>
            </Button>
            <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Width="96" TextAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" FontSize="11" Text="00:00.0 / 00:00.0"/>
            <Slider x:Name="Scrubber" Minimum="0" Maximum="{Binding Duration}" VerticalAlignment="Center" Margin="4,0"
                    ValueChanged="OnScrub" IsMoveToPointEnabled="True"/>
          </DockPanel>
        </Grid>
      </Border>

      <!-- Session panel -->
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8">
        <DockPanel>
          <!-- Now -->
          <StackPanel DockPanel.Dock="Top" Margin="10,9,10,6">
            <DockPanel>
              <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{StaticResource Faint}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource Accent}"/>
                        <DataTrigger.EnterActions>
                          <BeginStoryboard x:Name="Pulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.6"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                          <StopStoryboard BeginStoryboardName="Pulse"/>
                        </DataTrigger.ExitActions>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
            </DockPanel>
            <ProgressBar Margin="0,7,0,0" Value="{Binding StatusPercent, Mode=OneWay}" IsIndeterminate="{Binding StatusIndeterminate, Mode=OneWay}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
          <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource Line}"/>

          <TabControl x:Name="SideTabs" Margin="4,4,4,4">
            <TabItem Header="Activity">
              <ListBox ItemsSource="{Binding Activities}" Margin="0,4,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="6,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{StaticResource Muted}"
                                   Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="11" Foreground="{StaticResource Text}"
                                   Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="11" Foreground="{StaticResource Accent}"
                                   RenderTransformOrigin="0.5,0.5" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                          <TextBlock.RenderTransform>
                            <RotateTransform x:Name="Spin"/>
                          </TextBlock.RenderTransform>
                          <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                              <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                  <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.2"/>
                                </Storyboard>
                              </BeginStoryboard>
                            </EventTrigger>
                          </TextBlock.Triggers>
                        </TextBlock>
                      </Grid>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                  <Setter Property="TextDecorations" Value="Underline"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Faint}" Margin="0,1,0,0"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Margin="0,4,0,1" Height="2" Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="10" Foreground="{StaticResource Faint}" Margin="6,2,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="Claude">
              <ScrollViewer x:Name="AgentScroll" VerticalScrollBarVisibility="Auto" Padding="8">
                <TextBlock Text="{Binding AgentText}" TextWrapping="Wrap" LineHeight="18"/>
              </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ReviewTab" Header="Review">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="6,6,2,4">
                  <Button DockPanel.Dock="Right" Click="OnReview" IsEnabled="{Binding IsProjectOpen}" ToolTip="Check the edit for problems" AutomationProperties.Name="Check the edit for problems">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;"/>
                  </Button>
                  <TextBlock Text="{Binding ReviewSummary}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <ListBox ItemsSource="{Binding Findings}" SelectionChanged="OnFindingSelected">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="6,4">
                        <Button DockPanel.Dock="Right" Click="OnFix" Tag="{Binding}" VerticalAlignment="Top" Margin="6,0,0,0" MinHeight="22" MinWidth="22" Padding="3"
                                IsEnabled="{Binding DataContext.CanAsk, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Ask Claude to fix this" AutomationProperties.Name="Ask Claude to fix this">
                          <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="11" Foreground="{StaticResource Accent}"/>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="11" Width="18" VerticalAlignment="Top" Margin="0,2,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                              <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                          <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="{StaticResource Faint}"/>
                          <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>
            <TabItem Header="Summary">
              <TextBox Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                       Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6" VerticalContentAlignment="Top"/>
            </TabItem>
            <TabItem Header="History">
              <ListBox ItemsSource="{Binding History}" Margin="0,4,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="6,3">
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="64" Foreground="{StaticResource Faint}" FontSize="10"/>
                      <TextBlock Text="{Binding Action}" FontSize="11" Foreground="{StaticResource Muted}"/>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>

      <!-- Projects screen (covers the workspace) -->
      <Border Grid.ColumnSpan="3" Background="{StaticResource Bg}" Visibility="{Binding ShowStartScreen, Converter={StaticResource BoolToVis}}">
        <Grid MaxWidth="620" VerticalAlignment="Center" Margin="16,0">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Click="OnHideProjects" ToolTip="Back to the open project" AutomationProperties.Name="Back to the open project"
                      Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;"/>
              </Button>
              <TextBlock Text="Projects" FontSize="18" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock Text="{Binding EngineError}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasEngineError, Converter={StaticResource BoolToVis}}"/>
            <DockPanel Margin="0,8,0,10">
              <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="OnCreateProject" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0"/>
                  <TextBlock Text="New" Foreground="{StaticResource OnAccent}" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>
              <ComboBox DockPanel.Dock="Right" Width="74" Margin="6,0,0,0" ItemsSource="{Binding AspectRatios}" SelectedItem="{Binding NewProjectAspect}"/>
              <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" MinHeight="28"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,4">
              <Button DockPanel.Dock="Right" Click="OnOpenFolder" ToolTip="Open a project folder" AutomationProperties.Name="Open a project folder">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;"/>
              </Button>
              <TextBlock Text="Recent" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox ItemsSource="{Binding Projects}" MaxHeight="220" MouseDoubleClick="OnProjectDoubleClick" x:Name="ProjectList">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="6,6">
                    <Button DockPanel.Dock="Right" Click="OnOpenProject" Tag="{Binding Dir}" ToolTip="Open" AutomationProperties.Name="Open">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12"/>
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"/>
                      <TextBlock Text="{Binding Updated}" FontSize="10" Foreground="{StaticResource Faint}"/>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Timeline strip: compact preview; expand for full lanes -->
    <Border Grid.Row="2" Margin="8,6,8,0" Background="{StaticResource Panel}" CornerRadius="8" Padding="4,3">
      <DockPanel>
        <Button x:Name="ExpandTimeline" DockPanel.Dock="Right" Click="OnToggleTimeline" ToolTip="Show all timeline lanes" AutomationProperties.Name="Show all timeline lanes" VerticalAlignment="Top" MinHeight="22" MinWidth="24" Padding="4,2">
          <TextBlock x:Name="ExpandIcon" Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="10"/>
        </Button>
        <ScrollViewer x:Name="TimelineScroll" VerticalScrollBarVisibility="Auto" MaxHeight="160">
          <controls:TimelineView x:Name="Timeline"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Ask Claude: one box holding the picked item, the request and the send (or stop) button -->
    <Grid Grid.Row="3" Margin="8,6,8,8">
      <Border Background="{StaticResource Panel2}" CornerRadius="10" BorderThickness="1" BorderBrush="#2E2E2E" Padding="10,6,6,6">
        <StackPanel>
          <!-- What the request is about: pills above the text for the item picked on the timeline and the spot clicked in the frame -->
          <StackPanel x:Name="Pills" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
            <Border x:Name="PickChip" Visibility="Collapsed" Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="8,1,2,1" Margin="0,0,6,0" MaxWidth="300">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PickText" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250" Foreground="{StaticResource Text}"/>
                <Button Click="OnClearPick" ToolTip="Clear" AutomationProperties.Name="Clear the picked item" MinHeight="18" MinWidth="18" Padding="0" Margin="4,0,0,0">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="8"/>
                </Button>
              </StackPanel>
            </Border>
            <Border x:Name="SpotChip" Visibility="Collapsed" Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="8,1,2,1">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE707;" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SpotText" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                <Button Click="OnClearSpot" ToolTip="Clear" AutomationProperties.Name="Clear the spot" MinHeight="18" MinWidth="18" Padding="0" Margin="4,0,0,0">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="8"/>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="OnStopClaude" ToolTip="Stop Claude" AutomationProperties.Name="Stop Claude"
                    Width="28" Height="28" Padding="0" Margin="6,0,0,0" VerticalAlignment="Bottom"
                    Visibility="{Binding AgentRunning, Converter={StaticResource BoolToVis}}">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="11" Foreground="{StaticResource OnAccent}"/>
            </Button>
            <Button DockPanel.Dock="Right" Click="OnAsk" IsEnabled="{Binding CanAsk}" ToolTip="Ask Claude" AutomationProperties.Name="Ask Claude"
                    Width="28" Height="28" Padding="0" Margin="6,0,0,0" VerticalAlignment="Bottom">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding AgentRunning}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="12" Foreground="{StaticResource OnAccent}"/>
            </Button>
            <Grid VerticalAlignment="Center">
              <TextBox x:Name="PromptBox" KeyDown="OnPromptKeyDown" IsEnabled="{Binding CanAsk}" Background="Transparent" Padding="0,4" MinHeight="26"/>
              <TextBlock x:Name="PromptHint" Text="{Binding AskHint}" Foreground="{StaticResource Faint}" Margin="2,0,8,0" VerticalAlignment="Center"
                         IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Activity glow: while anything runs, a light travels around the box and it softly glows -->
      <Border CornerRadius="10" BorderThickness="1.5" IsHitTestVisible="False" Opacity="0">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
            <LinearGradientBrush.RelativeTransform>
              <RotateTransform CenterX="0.5" CenterY="0.5"/>
            </LinearGradientBrush.RelativeTransform>
            <GradientStop Color="#1D4ED8" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="0.35"/>
            <GradientStop Color="#BFDBFE" Offset="0.5"/>
            <GradientStop Color="#3B82F6" Offset="0.65"/>
            <GradientStop Color="#1D4ED8" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
          <DropShadowEffect Color="#3B82F6" BlurRadius="16" ShadowDepth="0" Opacity="0.75"/>
        </Border.Effect>
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <DataTrigger.EnterActions>
                  <BeginStoryboard x:Name="Glow">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35"/>
                      <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(Brush.RelativeTransform).(RotateTransform.Angle)"
                                       From="0" To="360" Duration="0:0:2.4" RepeatBehavior="Forever"/>
                      <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                       From="0.35" To="0.85" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="Glow"/>
                </DataTrigger.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>
    </Grid>
  </Grid>
</Window>
