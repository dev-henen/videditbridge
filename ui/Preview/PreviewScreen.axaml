<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:VideoEditor.Shared"
             x:Class="VideoEditor.Preview.PreviewScreen">
  <Border Background="{StaticResource Panel}" CornerRadius="8">
    <Grid Margin="6" RowDefinitions="Auto,*,Auto">
      <!-- Live or paused, and what is shown -->
      <DockPanel Grid.Row="0" Margin="2,0,0,5">
        <Border x:Name="LiveBadge" DockPanel.Dock="Left" Background="#26FFFFFF" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource Text}" Margin="0,0,5,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="LiveText" Text="LIVE" FontSize="10" FontWeight="Bold"/>
          </StackPanel>
        </Border>
        <Button x:Name="FollowButton" DockPanel.Dock="Right" Click="OnFollowLive" ToolTip.Tip="Follow live output" AutomationProperties.Name="Follow live output"
                IsVisible="False" MinHeight="22" Padding="6,2">
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="icon" Text="{x:Static shared:Icons.Sync}" FontSize="13" Margin="0,0,5,0"/>
            <TextBlock Text="Follow live" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <!-- What the viewer lays over the picture: the matte of the mask in this clip, and the outline of
             the object Claude selected (shown once there is one) -->
        <ToggleButton x:Name="MatteButton" DockPanel.Dock="Right" Click="OnOverlayToggle" MinHeight="22" Padding="6,2" Margin="4,0,0,0"
                      ToolTip.Tip="Show the mask of this clip (or of the clip picked on the timeline), white on black" AutomationProperties.Name="Show the mask">
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="icon" Text="{x:Static shared:Icons.Image}" FontSize="13" Margin="0,0,5,0"/>
            <TextBlock Text="Matte" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="OutlineButton" DockPanel.Dock="Right" Click="OnOverlayToggle" IsVisible="{Binding HasObjects}" IsChecked="True" MinHeight="22" Padding="6,2" Margin="4,0,0,0"
                      ToolTip.Tip="Outline the object Claude selected" AutomationProperties.Name="Outline the selected object">
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="icon" Text="{x:Static shared:Icons.Sparkle}" FontSize="13" Margin="0,0,5,0"/>
            <TextBlock Text="Object" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <TextBlock x:Name="ViewerCaption" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11"
                   Text="Following the latest output" TextTrimming="CharacterEllipsis"/>
      </DockPanel>

      <Border Grid.Row="1" Background="Black" CornerRadius="6" ClipToBounds="True">
        <!-- Click the picture to point Claude at a spot in the frame -->
        <Grid x:Name="ViewerArea" Background="Transparent" PointerReleased="OnViewerClick" SizeChanged="OnViewerResized" Cursor="Cross">
          <!-- Frames, the overview and video playback all show here (video frames come from the player) -->
          <Image x:Name="FrameImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"/>
          <!-- The matte (white on black, in place of the picture) or the selected object's outline (over it) -->
          <Image x:Name="OverlayImage" Stretch="Uniform" IsHitTestVisible="False" IsVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality"/>
          <TextBlock x:Name="ViewerEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Faint}"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="20" Text="Nothing to show yet"/>
          <Canvas IsHitTestVisible="False">
            <Grid x:Name="SpotMarker" Width="18" Height="18" IsVisible="False">
              <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2" Fill="{StaticResource AccentSoft}"/>
              <Ellipse Width="4" Height="4" Fill="{StaticResource Accent}"/>
            </Grid>
          </Canvas>
        </Grid>
      </Border>

      <!-- Transport -->
      <DockPanel Grid.Row="2" Margin="0,5,2,0" IsEnabled="{Binding IsProjectOpen}">
        <Button x:Name="PlayButton" DockPanel.Dock="Left" Click="OnPlayPause" ToolTip.Tip="Play / pause" AutomationProperties.Name="Play / pause" MinHeight="24">
          <TextBlock x:Name="PlayIcon" Classes="icon" Text="{x:Static shared:Icons.Play}" FontSize="14" Foreground="{StaticResource Text}"/>
        </Button>
        <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Width="96" TextAlignment="Right" VerticalAlignment="Center"
                   Foreground="{StaticResource Muted}" FontSize="11" Text="00:00.0 / 00:00.0"/>
        <!-- A/B: the frame as it was before the latest request to Claude -->
        <ToggleButton x:Name="BeforeButton" DockPanel.Dock="Right" Click="OnBefore" IsVisible="False" MinHeight="24" Padding="6,2" Margin="4,0,0,0"
                      ToolTip.Tip="Show this frame as it was before your last request" AutomationProperties.Name="Show the frame before your last request">
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="icon" Text="{x:Static shared:Icons.History}" FontSize="13" Margin="0,0,5,0"/>
            <TextBlock Text="Before" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <Slider x:Name="Scrubber" Minimum="0" Maximum="{Binding Duration}" VerticalAlignment="Center" Margin="4,0" MinHeight="0" Padding="0"
                IsSnapToTickEnabled="False"/>
      </DockPanel>
    </Grid>
  </Border>
</UserControl>
