<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="using:VideoEditor.Tabs"
        xmlns:shared="using:VideoEditor.Shared"
        x:Class="VideoEditor.Shell.MainWindow"
        Title="{Binding Title}" Width="960" Height="460" MinWidth="760" MinHeight="400"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        Icon="/Assets/AppIcon.png"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="PreferSystemChrome" ExtendClientAreaTitleBarHeightHint="38">
  <Window.Resources>
    <!-- The title bar: solid, or see-through to the system material (Mica, acrylic) where there is one (MainWindow.UseMaterial) -->
    <SolidColorBrush x:Key="TitleBarBg" Color="#0A0A0A"/>
  </Window.Resources>
  <Window.Styles>
    <!-- A row of the tab search: flat, full width, lit on hover; the current tab in the accent color -->
    <Style Selector="Button.side">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Margin" Value="6,0"/>
    </Style>
    <Style Selector="Button.side.row">
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="Button.side:pressed /template/ Border#b">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Button.side.current /template/ Border#b">
      <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
    </Style>
    <!-- The square behind a row's icon -->
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="#2A2A2A"/>
    </Style>
    <Style Selector="Border.tile TextBlock.icon">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style Selector="Button.side.current Border.tile TextBlock.icon">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
    </Style>
    <!-- A tab's close button shows while its row is hovered -->
    <Style Selector="Button.rowClose">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinWidth" Value="24"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.side:pointerover Button.rowClose">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="TextBlock.sideHead">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="16,8,0,6"/>
    </Style>
    <Style Selector="TextBlock.sideNote">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Faint}"/>
      <Setter Property="Margin" Value="16,0,16,4"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- The search box: bare, the card is the box -->
    <Style Selector="TextBox.search">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="0,8"/>
    </Style>
  </Window.Styles>
  <!-- The layout only: the tabs in the title bar, like a browser, over the open tab's page.
       Each tab's page holds everything of its project; nothing is shared between tabs. -->
  <Grid RowDefinitions="38,*">
    <!-- The title bar's color; it lets clicks through, so its empty parts move the window -->
    <Border Grid.Row="0" Background="{DynamicResource TitleBarBg}" IsHitTestVisible="False"/>
    <tabs:TabStrip x:Name="Tabs" Grid.Row="0"/>
    <Panel Grid.Row="1" x:Name="Pages" Background="{StaticResource Bg}"/>

    <!-- Tab search (the chevron at the top left, or Ctrl+Shift+A), laid out like a browser's: a card dropped down
         over the page as it is (no dimming or blur, no animation). A click beside it or Escape closes it. -->
    <Panel Grid.Row="0" Grid.RowSpan="2" x:Name="SidePanel" IsVisible="False">
      <!-- Clear: only catches the click beside the card that closes it -->
      <Border Background="Transparent" PointerPressed="OnSideBackdrop"/>
      <Border Width="340" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,36,0,8" CornerRadius="10"
              Background="#1E1E1E" BorderBrush="#26FFFFFF" BorderThickness="1" BoxShadow="0 4 16 0 #59000000" ClipToBounds="True">
        <DockPanel>
          <!-- Search -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="16,6,14,6">
            <TextBlock Classes="icon" Text="{x:Static shared:Icons.Search}" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Classes="bare search" x:Name="SideSearch" Watermark="Search tabs" Margin="8,0" TextChanged="OnSideSearch" KeyDown="OnSideSearchKey"
                     AutomationProperties.Name="Search tabs"/>
            <TextBlock Grid.Column="2" Text="Ctrl+Shift+A" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
          </Grid>
          <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource Line}"/>

          <!-- New tab, help and settings -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="1" Margin="0,0,0,6">
            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,0,0,6"/>
            <Button Classes="side" Click="OnSideNewTab" AutomationProperties.Name="New tab">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Ctrl+T" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                <TextBlock Classes="icon" Text="{x:Static shared:Icons.Add}" FontSize="14" Width="32" TextAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="New tab" FontSize="12" VerticalAlignment="Center"/>
              </DockPanel>
            </Button>
            <Button Classes="side" Click="OnSideHelp" AutomationProperties.Name="Help and guides">
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="icon" Text="{x:Static shared:Icons.Info}" FontSize="14" Width="32" TextAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Help and guides" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Classes="side" Click="OnSideSettings" AutomationProperties.Name="Settings">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Ctrl+," FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                <TextBlock Classes="icon" Text="{x:Static shared:Icons.Settings}" FontSize="14" Width="32" TextAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center"/>
              </DockPanel>
            </Button>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,4,0,6">
              <TextBlock Classes="sideHead" Text="Open tabs"/>
              <ItemsControl x:Name="SideTabs">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="side row" Classes.current="{Binding IsSelected}" Click="OnSideTab" Tag="{Binding}" ToolTip.Tip="{Binding Project.Dir, FallbackValue={x:Null}}"
                            AutomationProperties.Name="{Binding Label}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="tile">
                          <Panel>
                            <TextBlock Classes="icon" Text="{x:Static shared:Icons.Video}" IsVisible="{Binding IsProject}"/>
                            <TextBlock Classes="icon" Text="{x:Static shared:Icons.Home}" IsVisible="{Binding IsStart}"/>
                            <TextBlock Classes="icon" Text="{x:Static shared:Icons.Settings}" IsVisible="{Binding IsSettings}"/>
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Spacing="1">
                          <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="rowClose" Click="OnSideCloseTab" Tag="{Binding}" ToolTip.Tip="Close tab" AutomationProperties.Name="Close tab">
                          <TextBlock Classes="icon" Text="{x:Static shared:Icons.Dismiss}" FontSize="12"/>
                        </Button>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="SideNoTabs" Text="No open tab matches." Classes="sideNote" IsVisible="False"/>

              <TextBlock Classes="sideHead" Text="Recently closed" Margin="16,12,0,6"/>
              <TextBlock x:Name="SideNoneClosed" Text="Projects you close show here, to reopen." Classes="sideNote"/>
              <ItemsControl x:Name="SideClosed">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="side row" Click="OnSideReopen" Tag="{Binding}" ToolTip.Tip="{Binding Dir}" AutomationProperties.Name="{Binding Name}">
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="tile">
                          <TextBlock Classes="icon" Text="{x:Static shared:Icons.Reopen}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Spacing="1">
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>
  </Grid>
</Window>
