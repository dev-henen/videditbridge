<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:VideoEditor.Shared"
             xmlns:chat="using:VideoEditor.Chat"
             xmlns:session="using:VideoEditor.Session"
             x:Class="VideoEditor.Chat.ChatPanel">
  <UserControl.Styles>
    <Style Selector="Button.row">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style Selector="Border.current">
      <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
    </Style>
    <!-- A new message eases in: a short fade while it rises into place -->
    <Style Selector="ItemsControl#MessageList > ContentPresenter">
      <Setter Property="RenderTransform">
        <TranslateTransform/>
      </Setter>
      <Style.Animations>
        <Animation Duration="0:0:0.24" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="TranslateTransform.Y" Value="8"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="TranslateTransform.Y" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Border Background="{StaticResource Panel}" CornerRadius="8">
    <DockPanel>
      <!-- The conversation: its title (double-click to rename), the history and a new one -->
      <DockPanel DockPanel.Dock="Top" Margin="10,5,5,5">
        <Button DockPanel.Dock="Right" Click="OnNewConversation" ToolTip.Tip="New conversation" AutomationProperties.Name="New conversation"
                IsEnabled="{Binding !AgentRunning}">
          <TextBlock Classes="icon" Text="{x:Static shared:Icons.Compose}"/>
        </Button>
        <Button x:Name="HistoryButton" DockPanel.Dock="Right" ToolTip.Tip="Conversations" AutomationProperties.Name="Conversations">
          <TextBlock Classes="icon" Text="{x:Static shared:Icons.History}"/>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" Opening="OnHistoryOpening">
              <StackPanel Width="250" Margin="-6">
                <TextBlock Text="Conversations" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,2,0,6"/>
                <TextBlock x:Name="NoConversations" Text="No saved conversations yet" FontSize="11" Foreground="{StaticResource Faint}" Margin="8,0,0,6"/>
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="ConversationList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="6" Classes.current="{Binding IsCurrent}" Margin="0,1">
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Click="OnDeleteConversation" Tag="{Binding}" ToolTip.Tip="Delete" AutomationProperties.Name="Delete this conversation"
                                    MinHeight="24" MinWidth="24" Padding="3" VerticalAlignment="Center">
                              <TextBlock Classes="icon" Text="{x:Static shared:Icons.Delete}" FontSize="13" Foreground="{StaticResource Muted}"/>
                            </Button>
                            <Button Classes="row" Click="OnOpenConversation" Tag="{Binding}" AutomationProperties.Name="{Binding Title}">
                              <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Updated}" FontSize="10" Foreground="{StaticResource Faint}"/>
                              </StackPanel>
                            </Button>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBlock DockPanel.Dock="Left" Classes="icon" Text="{x:Static shared:Icons.Chat}" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,0,7,0"/>
        <Grid VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="{Binding ConversationTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     DoubleTapped="OnStartRename" ToolTip.Tip="Double-click to rename" Background="Transparent"/>
          <TextBox x:Name="TitleBox" IsVisible="False" MinHeight="24" Padding="6,2" KeyDown="OnRenameKey" LostFocus="OnRenameLostFocus"/>
        </Grid>
      </DockPanel>
      <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource Line}"/>

      <chat:ChatComposer x:Name="Composer" DockPanel.Dock="Bottom" Margin="6"/>

      <!-- The provider's cache of the conversation: while warm, the next request reads it at a fraction of the price -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="10,4,8,0" IsVisible="{Binding ShowCache}"
                  ToolTip.Tip="{Binding CacheTip}" Background="Transparent">
        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{StaticResource Accent}" IsVisible="{Binding CacheWarm}"/>
        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Stroke="{StaticResource Muted}" StrokeThickness="1" IsVisible="{Binding !CacheWarm}"/>
        <TextBlock Text="{Binding CacheText}" FontSize="11" Foreground="{StaticResource Muted}"/>
      </StackPanel>

      <!-- How full the conversation is: shows from half the limit; summarizing keeps requests small -->
      <Border DockPanel.Dock="Bottom" Margin="8,6,8,0" IsVisible="{Binding ShowContext}" ToolTip.Tip="{Binding ContextTip}">
        <DockPanel>
          <Panel DockPanel.Dock="Left" Width="14" Height="14" Margin="0,1,7,0" VerticalAlignment="Top">
            <Ellipse Stroke="{StaticResource Line}" StrokeThickness="2"/>
            <Arc Stroke="{StaticResource Accent}" StrokeThickness="2" StartAngle="-90" SweepAngle="{Binding ContextSweep}"/>
          </Panel>
          <StackPanel>
            <TextBlock Text="{Binding ContextText}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <Button Click="OnCompact" IsEnabled="{Binding !AgentRunning}" Padding="0" MinHeight="0" MinWidth="0" HorizontalAlignment="Left" Background="Transparent" AutomationProperties.Name="Summarize the conversation now">
              <TextBlock Text="Summarize now" FontSize="11" Foreground="{StaticResource AccentHover}"/>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- An edit plan the AI proposed: approve it, or say what to change -->
      <Border DockPanel.Dock="Bottom" Margin="6,6,6,0" Padding="10,8" CornerRadius="10" Background="{StaticResource Panel2}"
              BorderBrush="{StaticResource Accent}" BorderThickness="1" IsVisible="{Binding HasPlan}">
        <StackPanel Spacing="6" DataContext="{Binding Plan}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Click="OnDismissPlan" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" ToolTip.Tip="Close the plan" AutomationProperties.Name="Close the plan">
              <TextBlock Classes="icon" Text="{x:Static shared:Icons.Dismiss}" FontSize="11"/>
            </Button>
            <TextBlock Classes="icon" DockPanel.Dock="Left" Text="{x:Static shared:Icons.Document}" FontSize="14" Foreground="{StaticResource AccentHover}" Margin="0,0,7,0"/>
            <StackPanel>
              <TextBlock Text="Proposed plan" FontSize="10.5" Foreground="{StaticResource Muted}"/>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2">
                    <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="9" Background="{StaticResource AccentSoft}" Margin="0,0,8,0" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Number}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="{Binding Notes}" IsVisible="{Binding HasNotes}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Button Click="OnChangePlan" AutomationProperties.Name="Change the plan" Padding="10,4">
              <TextBlock Text="Change it" FontSize="12"/>
            </Button>
            <Button Classes="primary" Click="OnApprovePlan" AutomationProperties.Name="Approve the plan" Padding="12,4">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Classes="icon" Text="{x:Static shared:Icons.Check}" FontSize="12" Foreground="{StaticResource OnAccent}"/>
                <TextBlock Text="Approve" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnAccent}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Options Claude offered: play or look, then pick -->
      <Border DockPanel.Dock="Bottom" Margin="6,6,6,0" Padding="8,6" CornerRadius="8" Background="{StaticResource Panel2}" IsVisible="{Binding HasChoices}">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Click="OnDismissChoices" ToolTip.Tip="Close without picking" AutomationProperties.Name="Close the options"
                    MinHeight="20" MinWidth="20" Padding="2">
              <TextBlock Classes="icon" Text="{x:Static shared:Icons.Dismiss}" FontSize="11"/>
            </Button>
            <TextBlock Text="{Binding ChoiceQuestion}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
          <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Choices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,3" Padding="6" CornerRadius="6" Background="{StaticResource Panel}">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="primary" Click="OnPickChoice" Tag="{Binding}" Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0"
                              Margin="6,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Pick this" AutomationProperties.Name="Pick this"
                              IsEnabled="{Binding $parent[ItemsControl].DataContext.CanAsk}">
                        <TextBlock Classes="icon" Text="{x:Static shared:Icons.Check}" FontSize="13" Foreground="{StaticResource OnAccent}"/>
                      </Button>
                      <Button DockPanel.Dock="Left" Click="OnPlayChoice" Tag="{Binding}" MinHeight="22" MinWidth="22" Padding="2" Margin="0,0,6,0" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding PlayHint}" AutomationProperties.Name="Play this option" IsVisible="{Binding HasAudio}">
                        <TextBlock Classes="icon" Text="{Binding PlayGlyph}" FontSize="13" Foreground="{StaticResource Accent}"/>
                      </Button>
                      <Border DockPanel.Dock="Left" CornerRadius="4" ClipToBounds="True" Margin="0,0,8,0" IsVisible="{Binding HasImage}">
                        <Image Source="{Binding ImageBitmap}" Height="54" MaxWidth="96" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Grid>
        <!-- An empty conversation: what the assistant (Claude, ChatGPT or Gemini) can do here -->
        <StackPanel VerticalAlignment="Center" Margin="18,0" Spacing="6" IsVisible="{Binding !HasMessages}">
          <TextBlock Classes="icon" Text="{x:Static shared:Icons.Sparkle}" FontSize="22" Foreground="{StaticResource Accent}"/>
          <TextBlock Text="{Binding EmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="Describe the video you want, point at a clip on the timeline or a spot in the frame, or add files with +."
                     FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}" Margin="10,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Panel Margin="0,4">
                  <!-- A request: on the right, on a chip, with what it was about and its files -->
                  <StackPanel IsVisible="{Binding IsUser}" HorizontalAlignment="Right" MaxWidth="250">
                    <TextBlock Text="{Binding About}" FontSize="10" Foreground="{StaticResource Faint}" HorizontalAlignment="Right" Margin="0,0,2,2"
                               IsVisible="{Binding HasAbout}" TextTrimming="CharacterEllipsis"/>
                    <Border Background="{StaticResource Panel2}" CornerRadius="10,10,3,10" Padding="10,6">
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" LineHeight="17"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}" HorizontalAlignment="Right" Margin="0,3,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{StaticResource Hover}" CornerRadius="5" Padding="6,1" Margin="3,0,0,2">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Classes="icon" Text="{x:Static shared:Icons.Attach}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,4,0"/>
                              <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource Muted}" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <!-- A note from the app (the conversation was summarized): a quiet line across -->
                  <Grid IsVisible="{Binding IsNote}" ColumnDefinitions="*,Auto,*" Margin="0,6">
                    <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource Line}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Note}" FontSize="10.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="210" Margin="8,0"/>
                    <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource Line}" VerticalAlignment="Center"/>
                  </Grid>
                  <!-- Claude's reply: plain text on the left; a working line until it writes -->
                  <StackPanel IsVisible="{Binding IsAssistant}">
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding IsThinking}" Spacing="6">
                      <TextBlock Classes="icon spin" Text="{x:Static shared:Icons.Sync}" FontSize="12" Foreground="{StaticResource Accent}"/>
                      <TextBlock Text="Working on it" FontSize="11" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" LineHeight="18" IsVisible="{Binding HasText}"/>
                    <!-- The request failed: one plain sentence in its own box -->
                    <Border IsVisible="{Binding HasError}" Background="#1FEF4444" BorderBrush="#40EF4444" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                      <DockPanel>
                        <TextBlock Classes="icon" DockPanel.Dock="Left" Text="{x:Static shared:Icons.Warning}" FontSize="14" Foreground="#F87171" VerticalAlignment="Top" Margin="0,1,8,0"/>
                        <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{StaticResource Text}"/>
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- No API key yet: nothing to edit with, so the chat says where to add one -->
        <Border IsVisible="{Binding NoKey}" Background="{StaticResource Panel}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18,0" Spacing="8" MaxWidth="230">
            <TextBlock Classes="icon" Text="{x:Static shared:Icons.Key}" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            <TextBlock Text="Add an API key to start editing" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="Go to Settings and add a key for Claude, ChatGPT or Gemini. Then you can edit by asking here."
                       FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button Classes="primary" HorizontalAlignment="Center" Margin="0,4,0,0" Click="OnOpenSettings" AutomationProperties.Name="Open Settings to add an API key">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="icon" Text="{x:Static shared:Icons.Settings}" FontSize="13" Foreground="{StaticResource OnAccent}" VerticalAlignment="Center"/>
                <TextBlock Text="Open Settings" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnAccent}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button HorizontalAlignment="Center" Click="OnKeyGuide" AutomationProperties.Name="How to get an API key">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="How to get an API key" FontSize="11" Foreground="{StaticResource AccentHover}" VerticalAlignment="Center"/>
                <TextBlock Classes="icon" Text="{x:Static shared:Icons.Open}" FontSize="11" Foreground="{StaticResource AccentHover}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
