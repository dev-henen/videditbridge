<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VideoEditor.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Dark neutral palette with a blue primary color -->
    <SolidColorBrush x:Key="Bg" Color="#121212"/>
    <!-- Tabs in the title bar, like a browser: a dark row, and the open tab in the toolbar color of its page -->
    <SolidColorBrush x:Key="TabBar" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="TabHover" Color="#191919"/>
    <!-- The open tab and the bar under it, where its page's commands are -->
    <SolidColorBrush x:Key="Toolbar" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Panel" Color="#181818"/>
    <SolidColorBrush x:Key="Panel2" Color="#222222"/>
    <SolidColorBrush x:Key="Hover" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="Line" Color="#262626"/>
    <SolidColorBrush x:Key="Text" Color="#EDEDED"/>
    <SolidColorBrush x:Key="Muted" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="Faint" Color="#5C5C5C"/>
    <!-- Blue is the primary color: the main action, selection, progress and the playhead. -->
    <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#5B9BFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#263B82F6"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <Color x:Key="SystemAccentColor">#3B82F6</Color>
    <!-- The theme's lighter and darker accent shades (switch hover and press) stay blue too -->
    <Color x:Key="SystemAccentColorLight1">#5B9BFF</Color>
    <Color x:Key="SystemAccentColorLight2">#7FB0FF</Color>
    <Color x:Key="SystemAccentColorLight3">#A3C6FF</Color>
    <Color x:Key="SystemAccentColorDark1">#2F6FD8</Color>
    <Color x:Key="SystemAccentColorDark2">#255DBA</Color>
    <Color x:Key="SystemAccentColorDark3">#1C4B9C</Color>
    <!-- Bundled icon font (Fluent UI System Icons, MIT), so icons look the same on every system -->
    <FontFamily x:Key="Icons">avares://VideditBridge/Assets/Fonts#FluentSystemIcons-Regular</FontFamily>

    <!-- Fluent theme pieces recolored to the palette -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="#333333"/>
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#5B9BFF"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#5B9BFF"/>
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF"/>
    <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">11</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">11</x:Double>
    <SolidColorBrush x:Key="TextControlBackground" Color="#222222"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#222222"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#222222"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#222222"/>

    <!-- Flat button: transparent until hovered; class "primary" is the one emphasized blue action -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="MinWidth" Value="30"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <!-- Hover colors fade in, and a press sinks the button a little -->
          <Border Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" RenderTransformOrigin="50%,50%">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="CubicEaseOut"/>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18"/>
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#b">
        <Setter Property="Background" Value="{StaticResource Hover}"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#b">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
      </Style>
      <Style Selector="^:disabled /template/ Border#b">
        <Setter Property="Opacity" Value="0.35"/>
      </Style>
      <Style Selector="^.primary">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        <Setter Property="Padding" Value="10,5"/>
      </Style>
      <Style Selector="^.primary:pointerover /template/ Border#b">
        <Setter Property="Background" Value="{StaticResource AccentHover}"/>
      </Style>
      <Style Selector="^.primary:disabled /template/ Border#b">
        <Setter Property="Opacity" Value="0.3"/>
      </Style>
    </ControlTheme>

    <!-- Tabs: small quiet labels, the selected one on a panel chip -->
    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="b" Padding="{TemplateBinding Padding}" Margin="0,0,2,0" CornerRadius="5" Background="Transparent">
            <Border.Transitions>
              <Transitions><BrushTransition Property="Background" Duration="0:0:0.14"/></Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:selected /template/ Border#b">
        <Setter Property="Background" Value="{StaticResource Panel2}"/>
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
      </Style>
    </ControlTheme>

    <!-- List rows: a faint hover, no selection fill -->
    <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="b" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions><BrushTransition Property="Background" Duration="0:0:0.14"/></Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#b">
        <Setter Property="Background" Value="#10FFFFFF"/>
      </Style>
    </ControlTheme>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Glyph from the bundled icon font -->
    <Style Selector="TextBlock.icon">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="{Binding $parent[ContentControl].Foreground}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.icon.spin">
      <Setter Property="RenderTransform">
        <RotateTransform/>
      </Setter>
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- A text box drawn by its container (the Ask box) -->
    <Style Selector="TextBox.bare, TextBox.bare:pointerover, TextBox.bare:focus, TextBox.bare:disabled">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement, TextBox.bare:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="MinHeight" Value="3"/>
      <Setter Property="Height" Value="3"/>
      <Setter Property="CornerRadius" Value="1.5"/>
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <!-- Drop-down lists float: rounded corners, a hairline edge -->
    <Style Selector="ComboBox /template/ Border#PopupBorder">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="Padding" Value="4"/>
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Margin" Value="0,1"/>
    </Style>
  </Application.Styles>
</Application>
