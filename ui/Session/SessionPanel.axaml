<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:VideoEditor.Shared"
             x:Class="VideoEditor.Session.SessionPanel">
  <UserControl.Styles>
    <!-- Five tabs in a narrow panel: an icon each, and the name of the open one beside its icon -->
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="6,5"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <!-- Status dot: grey when idle, a pulsing blue while anything runs -->
    <Style Selector="Ellipse.status">
      <Setter Property="Fill" Value="{StaticResource Faint}"/>
    </Style>
    <Style Selector="Ellipse.status.busy">
      <Setter Property="Fill" Value="{StaticResource Accent}"/>
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Activity labels: muted when finished, bright while running, underlined on error -->
    <Style Selector="TextBlock.activity">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style Selector="TextBlock.activity.running">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="TextBlock.activity.error">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="TextDecorations" Value="Underline"/>
    </Style>
    <Style Selector="TextBlock.finding">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style Selector="TextBlock.finding.problem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{StaticResource Panel}" CornerRadius="8">
    <DockPanel>
      <!-- Now -->
      <StackPanel DockPanel.Dock="Top" Margin="10,9,10,6">
        <DockPanel>
          <Ellipse DockPanel.Dock="Left" Classes="status" Classes.busy="{Binding IsBusy}" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}"/>
        </DockPanel>
        <ProgressBar Margin="0,7,0,0" Value="{Binding StatusPercent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding StatusIndeterminate, Mode=OneWay}"
                     IsVisible="{Binding IsBusy}"/>
      </StackPanel>
      <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource Line}"/>

      <!-- The tabs share one row, centered; only the open tab shows its name, so all five fit -->
      <TabControl x:Name="Tabs" Margin="4" Padding="0">
        <TabControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate>
        </TabControl.ItemsPanel>
        <TabItem ToolTip.Tip="Activity" AutomationProperties.Name="Activity">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="icon" Text="{x:Static shared:Icons.Sync}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Text="Activity" VerticalAlignment="Center" IsVisible="{Binding $parent[TabItem].IsSelected}"/>
            </StackPanel>
          </TabItem.Header>
          <ListBox ItemsSource="{Binding Activities}" Margin="0,4,0,0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="6,4" ColumnDefinitions="20,*,Auto">
                  <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,1,0,0">
                    <TextBlock Classes="icon" Text="{x:Static shared:Icons.Check}" FontSize="13" Foreground="{StaticResource Muted}" IsVisible="{Binding IsDone}"/>
                    <TextBlock Classes="icon" Text="{x:Static shared:Icons.Error}" FontSize="13" Foreground="{StaticResource Text}" IsVisible="{Binding IsError}"/>
                    <TextBlock Classes="icon spin" Text="{x:Static shared:Icons.Sync}" FontSize="13" Foreground="{StaticResource Accent}" IsVisible="{Binding IsRunning}"/>
                  </Grid>
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="activity" Classes.running="{Binding IsRunning}" Classes.error="{Binding IsError}" Text="{Binding Label}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Faint}" Margin="0,1,0,0"
                               IsVisible="{Binding HasDetail}" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Margin="0,4,0,1" Height="2" MinHeight="2" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                 IsVisible="{Binding ShowProgress}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="10" Foreground="{StaticResource Faint}" Margin="6,2,0,0"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem x:Name="ReviewTab" ToolTip.Tip="Review" AutomationProperties.Name="Review">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="icon" Text="{x:Static shared:Icons.Review}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Text="Review" VerticalAlignment="Center" IsVisible="{Binding $parent[TabItem].IsSelected}"/>
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="6,6,2,4">
              <Button DockPanel.Dock="Right" Click="OnReview" IsEnabled="{Binding IsProjectOpen}" ToolTip.Tip="Check the edit for problems" AutomationProperties.Name="Check the edit for problems">
                <TextBlock Classes="icon" Text="{x:Static shared:Icons.Review}"/>
              </Button>
              <TextBlock Text="{Binding ReviewSummary}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <!-- Scopes of the frame where the selected finding happens -->
            <Border x:Name="ScopesPanel" DockPanel.Dock="Bottom" IsVisible="False" Background="Black" CornerRadius="6" Margin="4,4,4,2" Padding="4">
              <StackPanel>
                <TextBlock x:Name="ScopesCaption" FontSize="10" Foreground="{StaticResource Faint}" Margin="2,0,0,3"/>
                <Image x:Name="ScopesImage" Stretch="Uniform" MaxHeight="190" RenderOptions.BitmapInterpolationMode="HighQuality"/>
              </StackPanel>
            </Border>
            <ListBox ItemsSource="{Binding Findings}" SelectionChanged="OnFindingSelected">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="6,4">
                    <Button DockPanel.Dock="Right" Click="OnFix" Tag="{Binding}" VerticalAlignment="Top" Margin="6,0,0,0" MinHeight="22" MinWidth="22" Padding="3"
                            IsEnabled="{Binding $parent[UserControl].DataContext.CanAsk}"
                            ToolTip.Tip="Ask Claude to fix this" AutomationProperties.Name="Ask Claude to fix this">
                      <TextBlock Classes="icon" Text="{x:Static shared:Icons.Wrench}" FontSize="13" Foreground="{StaticResource Accent}"/>
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Classes="icon finding" Classes.problem="{Binding IsProblem}" Text="{Binding Glyph}" FontSize="13" Width="18"
                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel>
                      <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="{StaticResource Faint}"/>
                      <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
        <TabItem ToolTip.Tip="Summary" AutomationProperties.Name="Summary">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="icon" Text="{x:Static shared:Icons.Document}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Text="Summary" VerticalAlignment="Center" IsVisible="{Binding $parent[TabItem].IsSelected}"/>
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <!-- What the AI remembers about this project (remember, scope project); removable -->
            <Border DockPanel.Dock="Top" Margin="2,6,2,4" Padding="8,6" CornerRadius="8" Background="{StaticResource Panel2}" IsVisible="{Binding HasProjectMemory}">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="{x:Static shared:Icons.Bot}" FontSize="12" Foreground="{StaticResource AccentHover}"/>
                  <TextBlock Text="Remembered for this project" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ProjectMemory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,2,0,0">
                        <Button DockPanel.Dock="Right" Click="OnForgetMemory" Tag="{Binding Id}" Width="18" Height="18" MinWidth="0" MinHeight="0" Padding="0"
                                ToolTip.Tip="Forget this" AutomationProperties.Name="Forget this" VerticalAlignment="Top">
                          <TextBlock Classes="icon" Text="{x:Static shared:Icons.DismissSmall}" FontSize="9"/>
                        </Button>
                        <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <TextBox Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="10.5"
                     Classes="bare" TextWrapping="Wrap" Padding="6" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          </DockPanel>
        </TabItem>
        <TabItem ToolTip.Tip="Media" AutomationProperties.Name="Media">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="icon" Text="{x:Static shared:Icons.Image}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Text="Media" VerticalAlignment="Center" IsVisible="{Binding $parent[TabItem].IsSelected}"/>
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding MediaSummary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="6,6,6,4" TextWrapping="Wrap"/>
            <!-- Every media item in the project; clicking one goes to where the edit first uses it, the bin removes it -->
            <ListBox ItemsSource="{Binding Media}" SelectionChanged="OnMediaSelected">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="4,4" ToolTip.Tip="{Binding Tip}">
                    <Button DockPanel.Dock="Right" Click="OnRemoveMedia" Tag="{Binding}" VerticalAlignment="Top" Margin="4,0,0,0" MinHeight="22" MinWidth="22" Padding="3"
                            ToolTip.Tip="Remove from the project" AutomationProperties.Name="Remove from the project">
                      <TextBlock Classes="icon" Text="{x:Static shared:Icons.Delete}" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </Button>
                    <Border DockPanel.Dock="Left" Width="56" Height="36" CornerRadius="4" ClipToBounds="True" Background="{StaticResource Panel2}" Margin="0,0,8,0" VerticalAlignment="Top">
                      <Panel>
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" IsVisible="{Binding HasThumb}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <Border Background="{Binding Swatch}" IsVisible="{Binding HasSwatch}"/>
                        <TextBlock Classes="icon" Text="{Binding Glyph}" FontSize="16" Foreground="{StaticResource Muted}" IsVisible="{Binding ShowGlyph}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Panel>
                    </Border>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Info}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Usage}" FontSize="10" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
        <TabItem ToolTip.Tip="History" AutomationProperties.Name="History">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="icon" Text="{x:Static shared:Icons.History}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Text="History" VerticalAlignment="Center" IsVisible="{Binding $parent[TabItem].IsSelected}"/>
            </StackPanel>
          </TabItem.Header>
          <Panel>
            <TextBlock Text="Edits, renders and files show here as they happen, and stay with the project."
                       IsVisible="{Binding !HasHistory}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="8,10"/>
            <!-- The project's whole history, kept in its folder (engine/host/journal.ts), newest first -->
            <ListBox ItemsSource="{Binding History}" Margin="0,4,0,0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="6,3" ColumnDefinitions="20,*">
                    <TextBlock Classes="icon finding" Classes.problem="{Binding IsError}" Text="{Binding Glyph}" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding When}" FontSize="10" Foreground="{StaticResource Faint}"/>
                      <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="10" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                                 MaxHeight="28" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Border>
</UserControl>
