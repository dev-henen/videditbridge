<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VideditBridge</AssemblyName>
    <RootNamespace>VideoEditor</RootNamespace>
    <Product>VideditBridge</Product>
    <!-- Shown in the executable's properties (Windows), the About page and the packages -->
    <Version>0.1.1</Version>
    <Authors>Moses Henen</Authors>
    <Company>Moses Henen</Company>
    <Copyright>Copyright (c) 2026 Moses Henen</Copyright>
    <Description>Edit videos by asking Claude, ChatGPT or Gemini</Description>
    <RepositoryUrl>https://github.com/dev-henen/videditbridge</RepositoryUrl>
    <PackageProjectUrl>https://github.com/dev-henen/videditbridge</PackageProjectUrl>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <!-- Used for the Windows build only; macOS and Linux metadata lives in Packaging/. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <!-- Video and audio playback: LibVLC, linked dynamically (LGPL 2.1, shipped unmodified). -->
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
  </ItemGroup>

  <!-- VLC's native libraries: bundled on Windows and macOS; Linux uses the system's libvlc (the vlc package). -->
  <ItemGroup Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))) Or $(RuntimeIdentifier.StartsWith('win'))">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
  <ItemGroup Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))) Or $(RuntimeIdentifier.StartsWith('osx'))">
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2" />
  </ItemGroup>

</Project>
