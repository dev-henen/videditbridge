<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:VideoEditor.Shared"
             xmlns:projects="using:VideoEditor.Projects"
             x:Class="VideoEditor.Projects.ProjectsScreen">
  <UserControl.Styles>
    <!-- A project card: its cover, name and when it changed; the cover lights up on hover -->
    <Style Selector="Button.card">
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Width" Value="168"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style Selector="Button.card projects|ProjectCover">
      <Setter Property="Opacity" Value="0.9"/>
    </Style>
    <Style Selector="Button.card:pointerover projects|ProjectCover">
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </UserControl.Styles>

  <!-- A new tab: start a project, or open one. The bar on top joins the open tab, as on a project page. -->
  <DockPanel Background="{StaticResource Bg}">
  <Border DockPanel.Dock="Top" Background="{StaticResource Toolbar}" Padding="12,4,8,4" MinHeight="34">
    <DockPanel>
      <Button DockPanel.Dock="Right" Click="OnOpenFolder" ToolTip.Tip="Open a project folder" AutomationProperties.Name="Open a project folder">
        <StackPanel Orientation="Horizontal">
          <TextBlock Classes="icon" Text="{x:Static shared:Icons.FolderOpen}" FontSize="14" Margin="0,0,6,0"/>
          <TextBlock Text="Open folder" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <TextBlock Text="Projects" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="740" Margin="20,16,20,16">
      <TextBlock Text="{Binding EngineError}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,10" IsVisible="{Binding HasEngineError}"/>

      <TextBlock Text="New project" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
      <DockPanel Margin="0,0,0,18" MaxWidth="460" HorizontalAlignment="Left">
        <Button DockPanel.Dock="Right" Classes="primary" Click="OnCreateProject" Margin="6,0,0,0" IsEnabled="{Binding !IsStarting}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="icon" Text="{x:Static shared:Icons.Add}" FontSize="14" Foreground="{StaticResource OnAccent}" Margin="0,0,6,0"/>
            <TextBlock Text="Create" Foreground="{StaticResource OnAccent}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ComboBox DockPanel.Dock="Right" Width="80" Margin="6,0,0,0" ItemsSource="{Binding AspectRatios}" SelectedItem="{Binding NewProjectAspect}"
                  ToolTip.Tip="Shape of the video" AutomationProperties.Name="Shape of the video"/>
        <TextBox Text="{Binding NewProjectName}" Width="240" AutomationProperties.Name="Project name"/>
      </DockPanel>

      <TextBlock Text="Recent" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>

      <TextBlock Text="Starting the editing engine…" Foreground="{StaticResource Faint}" FontSize="11" IsVisible="{Binding IsStarting}"/>
      <ItemsControl ItemsSource="{Binding Projects}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="card" Click="OnOpenProject" Tag="{Binding Dir}" ToolTip.Tip="{Binding Dir}" AutomationProperties.Name="{Binding Name}">
              <StackPanel>
                <projects:ProjectCover Source="{Binding Cover}" Height="88"/>
                <TextBlock Text="{Binding Name}" Margin="2,6,2,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Updated}" FontSize="10" Foreground="{StaticResource Faint}" Margin="2,1,2,0"/>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
  </DockPanel>
</UserControl>
