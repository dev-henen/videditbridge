{
  "name": "videditbridge",
  "version": "0.1.0",
  "description": "AI-native video editing library: JSON timeline, templates, transcripts, captions, effects, transitions, animations, voice-over, and Claude-ready tool definitions. Renders with FFmpeg.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./library": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./claude": {
      "types": "./dist/claude/index.d.ts",
      "import": "./dist/claude/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ave": "./dist/cli.js",
    "ave-host": "./dist/host/main.js",
    "ave-mcp": "./dist/mcp/main.js"
  },
  "files": [
    "dist",
    "assets/fonts",
    "native/ave-native/*.node"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx engine/cli.ts",
    "docs": "tsx scripts/gen-docs.ts",
    "docs:check": "tsx scripts/gen-docs.ts --check",
    "host": "tsx engine/host/main.ts",
    "mcp": "tsx engine/mcp/main.ts",
    "native": "tsx scripts/build-native.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^3.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "^2.1.2",
    "openai": "^7.56.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@resvg/resvg-js": "^2.6.2",
    "ffmpeg-static": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "onnxruntime-node": "^1.21.0"
  }
}
